MAX_DIR=/var/lib/max-mcp
MAX_PORT=8766

# Куда разрешена отправка: me = Избранное, id чатов через запятую (из max_list_chats), * = любые
# (в многопользовательском режиме по умолчанию *: каждый подтверждает отправку в ассистенте)
MAX_SEND_ALLOW=me
# Лимит отправок в минуту на аккаунт
MAX_SEND_PER_MIN=20

# 1 = только чтение: инструменты отправки и изменения не регистрируются
READ_ONLY=0
# Часовой пояс для времени сообщений
TZ_NAME=Europe/Moscow
# Сколько последних событий держать в живой ленте (max_get_updates)
MAX_FEED_SIZE=2000

# ---- Сервис для многих пользователей: вставил ссылку → вошёл по QR → работает ----
# MAX_MULTIUSER=1
# Публичный https-адрес сервиса (тот, что видят ChatGPT и Claude; с ретранслятором — адрес ретранслятора)
# MAX_PUBLIC_URL=https://max.example.com
# Сколько пользователей принимать
# MAX_MAX_USERS=100
# Через сколько минут простоя закрывать подключение пользователя к MAX
# MAX_IDLE_MIN=60

# MAX_SECRET и MAX_MASTER_KEY дописываются установщиком автоматически
